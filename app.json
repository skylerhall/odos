{
  "expo": {
    "name": "ODOS",
    "slug": "odos",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skylerhall.odos"
    },
    "android": {
      "package": "com.skylerhall.odos",
      "adaptiveIcon": {
        "backgroundColor": "#101317",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ODOS uses your location for turn-by-turn directions, fuel tracking, and sharing where you are."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
