# Copy this file to .env and fill in your keys. .env is git-ignored.

# Required: Mapbox PUBLIC token (starts with pk.) from https://account.mapbox.com/access-tokens
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_token_here

# Optional: free key from https://ridb.recreation.gov (adds federal campgrounds to the rest finder)
EXPO_PUBLIC_RIDB_KEY=
